# Appwrite Configuration
# Find these values in your Appwrite Console under Settings and Database/Storage tabs.
# The endpoint should include your regional subdomain (e.g., https://fra.cloud.appwrite.io/v1)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_GALLERIES_COLLECTION_ID=galleries
NEXT_PUBLIC_APPWRITE_IMAGES_COLLECTION_ID=images
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=

# Google Analytics 4
# Paste the Measurement ID from your GA4 web data stream (looks like G-XXXXXXXXXX).
# Leave empty to disable GA tracking (no script will be injected).
NEXT_PUBLIC_GA_ID=
